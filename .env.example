# Cerebras API Key（設定画面からも登録できます）
CEREBRAS_API_KEY=

# NVIDIA NIM API Key（build.nvidia.com で発行。設定画面からも登録できます）
NVIDIA_API_KEY=

# Gemini API Key（aistudio.google.com で無料発行。クレカ登録不要の無料枠あり）
GEMINI_API_KEY=
# Optional second-account key. Prefer a path to a single-key file so the key
# does not need to be copied into this file (absolute or project-relative).
GEMINI_SECONDARY_API_KEY_FILE=
# Alternatively, set the second key directly; the key-file setting takes precedence.
GEMINI_SECONDARY_API_KEY=

# 初期AI Provider（cerebras / nvidia / gemini）
AI_PROVIDER=cerebras

# 初期モデル
AI_MODEL=gpt-oss-120b

# 生成設定
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=1024

# 会話履歴の送信制限（直近N件）
AI_HISTORY_LIMIT=50

# フォールバック（主プロバイダがレート制限等で失敗した時に自動で切り替え）
# AI_FALLBACK_PROVIDER=nvidia
# AI_FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b
# AI_FALLBACK_API_KEY=
